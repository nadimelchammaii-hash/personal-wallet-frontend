trackmywallet.org, www.trackmywallet.org {
	root * /srv
	encode gzip
	log {
		output stdout
		format console
	}

	@backend path /api/* /sanctum/*
	handle @backend {
		reverse_proxy backend:9000 {
			transport fastcgi {
				env SCRIPT_FILENAME /var/www/html/public/index.php
				env SCRIPT_NAME /index.php
			}
		}
	}

	# Hashed build assets never change content under the same filename, so
	# they can be cached forever. index.html (and every SPA route that falls
	# back to it) must never be cached by the browser, or returning visitors
	# keep an old build until they hard-refresh.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
