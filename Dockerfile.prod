# Production image. Unlike Dockerfile (dev, Vite dev server), this builds
# the SPA to static files and serves them with Caddy, which also reverse
# proxies /api and /sanctum straight to the backend's PHP-FPM process —
# frontend and backend share one origin in production (see project notes).

# ---- Stage 1: build static assets ----
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Baked into the built JS at build time (Vite env vars aren't runtime-configurable).
# Empty = same-origin relative requests, e.g. "/api/v1" instead of an absolute URL.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Plain `vite build`, not `npm run build` (which also runs vue-tsc type-
# checking in parallel) — type-checking already happens in local dev/CI
# before code reaches this point, and vue-tsc is memory-hungry enough to
# OOM a small VPS build for no benefit here.
RUN npx vite build

# ---- Stage 2: serve with Caddy ----
FROM caddy:2-alpine AS runtime

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 80 443
